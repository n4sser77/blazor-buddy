@using BlazorBuddy.Models
@using BlazorBuddy.WebApp.Services.Interfaces
@inject INotificationService NotificationService
@implements IDisposable
@rendermode InteractiveServer

<div class="toast-container">
    @foreach (var notification in _notifications)
    {
        <ToastNotification 
            Title="@notification.Title" 
            Description="@notification.Description"
            Type="@notification.Type"
            OnClose="@(() => RemoveNotification(notification.Id))" />
    }
</div>

@code {
    private List<Notification> _notifications = new();
    private Dictionary<Guid, System.Threading.Timer> _timers = new();
    private const int MaxNotifications = 5;
    private const int AutoDismissMs = 5000;

    protected override void OnInitialized()
    {
        NotificationService.OnNotificationReceived += HandleNotification;
    }

    private void HandleNotification(Notification notification)
    {
        InvokeAsync(() =>
        {
            // Add new notification
            _notifications.Add(notification);

            // Keep only the most recent notifications
            if (_notifications.Count > MaxNotifications)
            {
                var removed = _notifications[0];
                _notifications.RemoveAt(0);
                
                // Clean up timer for removed notification
                if (_timers.TryGetValue(removed.Id, out var oldTimer))
                {
                    oldTimer.Dispose();
                    _timers.Remove(removed.Id);
                }
            }

            StateHasChanged();

            // Auto-dismiss after delay using Timer
            var timer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() => RemoveNotification(notification.Id));
            }, null, AutoDismissMs, Timeout.Infinite);
            
            _timers[notification.Id] = timer;
        });
    }

    private void RemoveNotification(Guid id)
    {
        var notification = _notifications.FirstOrDefault(n => n.Id == id);
        if (notification != null)
        {
            _notifications.Remove(notification);
            
            // Clean up timer
            if (_timers.TryGetValue(id, out var timer))
            {
                timer.Dispose();
                _timers.Remove(id);
            }
            
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        NotificationService.OnNotificationReceived -= HandleNotification;
        
        // Dispose all timers
        foreach (var timer in _timers.Values)
        {
            timer.Dispose();
        }
        _timers.Clear();
    }
}
